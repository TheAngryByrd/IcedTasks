<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <DefineConstants>$(DefineConstants);TEST_NET6_0_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/IcedTasks/IcedTasks.fsproj" />
  </ItemGroup>
  <!-- PublicApiTests.fs reads the metadata of each build that IcedTasks.fsproj ships. No test run loads these builds. -->
  <Target Name="AddIcedTasksPublicApiReferences" BeforeTargets="AssignProjectConfiguration">
    <MSBuild Projects="../../src/IcedTasks/IcedTasks.fsproj" Targets="GetTargetFrameworks" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_IcedTasksBuildInfo" />
    </MSBuild>
    <ItemGroup>
      <IcedTasksShippedFramework Include="%(_IcedTasksBuildInfo.TargetFrameworks)" />
      <ProjectReference Include="../../src/IcedTasks/IcedTasks.fsproj" SetTargetFramework="TargetFramework=%(IcedTasksShippedFramework.Identity)" SkipGetTargetFrameworkProperties="true" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" OutputItemType="IcedTasksPublicApiAssembly" PublicApiFramework="%(IcedTasksShippedFramework.Identity)" />
    </ItemGroup>
  </Target>
  <Target Name="CopyIcedTasksPublicApiAssemblies" AfterTargets="ResolveProjectReferences">
    <WriteLinesToFile File="$(IntermediateOutputPath)shipped-target-frameworks.txt" Lines="@(IcedTasksShippedFramework)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)shipped-target-frameworks.txt" />
      <ContentWithTargetPath Include="$(IntermediateOutputPath)shipped-target-frameworks.txt" TargetPath="PublicApi/shipped-target-frameworks.txt" CopyToOutputDirectory="PreserveNewest" />
      <ContentWithTargetPath Include="@(IcedTasksPublicApiAssembly)" TargetPath="PublicApi/%(IcedTasksPublicApiAssembly.PublicApiFramework)/%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
      <ContentWithTargetPath Include="$(PkgMicrosoft_Bcl_AsyncInterfaces)/lib/netstandard2.0/Microsoft.Bcl.AsyncInterfaces.dll" TargetPath="PublicApi/netstandard2.0/Microsoft.Bcl.AsyncInterfaces.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Compile Include="Expect.fs" />
    <Compile Include="AsyncDisposalOutcome.fs" />
    <Compile Include="AsyncExTests.fs" />
    <Compile Include="TaskTests.fs" />
    <Compile Include="TaskBackgroundTests.fs" />
    <Compile Include="TaskDynamicTests.fs" />
    <Compile Include="ValueTaskTests.fs" />
    <Compile Include="ValueTaskDynamicTests.fs" />
    <Compile Include="PoolingValueTaskTests.fs" />
    <Compile Include="PoolingValueTaskDynamicTests.fs" />
    <Compile Include="CancellableTaskTests.fs" />
    <Compile Include="CancellableValueTaskTests.fs" />
    <Compile Include="CancellablePoolingValueTaskTests.fs" />
    <Compile Include="ColdTaskTests.fs" />
    <Compile Include="ParallelAsyncTests.fs" />
    <Compile Include="OpenFormsTests.fs" />
    <Compile Include="SuspensionAllocationTests.fs" />
    <Compile Include="PublicApiListing.fs" />
    <Compile Include="PublicApiTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" GeneratePathProperty="true" ExcludeAssets="all" />
    <Content Include="PublicApi/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>