<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The released package that this program is compiled against. The BinaryCompat FAKE target swaps in the current IcedTasks.dll. -->
    <PackageReference Include="IcedTasks" VersionOverride="0.11.9" />
    <!-- The FSharp.Core version of the current IcedTasks build that a consumer of each TFM loads after an upgrade. -->
    <PackageReference Include="FSharp.Core" VersionOverride="9.0.300" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="FSharp.Core" VersionOverride="11.0.101" Condition="'$(TargetFramework)' == 'net11.0'" />
  </ItemGroup>
</Project>
