<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The released package that this program is compiled against. The BinaryCompat FAKE target swaps in the current IcedTasks.dll. -->
    <PackageReference Include="IcedTasks" VersionOverride="0.11.9" />
    <!-- The current net11.0 build of IcedTasks needs FSharp.Core 11.0.101 at run time. -->
    <PackageReference Include="FSharp.Core" VersionOverride="11.0.101" />
  </ItemGroup>
</Project>
